# Add these values to app/.env. Do not commit app/.env.

# Existing controlled Microsoft Entra laboratory tenant GUID.
SUNHAVEN_TENANT_ID=00000000-0000-0000-0000-000000000000

# Local lab mode. Complete the one-time CurrentUser authentication described
# in the implementation guide before starting the worker.
SUNHAVEN_GRAPH_AUTH_MODE=Delegated

# Background-worker settings.
SUNHAVEN_WORKER_POLL_SECONDS=2
SUNHAVEN_JOB_TIMEOUT_SECONDS=900
SUNHAVEN_PWSH_PATH=pwsh

# Optional diagnostic stack traces. Keep disabled for normal evidence.
SUNHAVEN_WORKER_DEBUG=0

# Unattended certificate mode only. Configure these outside source control and
# grant only the documented Microsoft Graph application permissions.
# SUNHAVEN_GRAPH_AUTH_MODE=Certificate
# SUNHAVEN_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SUNHAVEN_GRAPH_CERT_THUMBPRINT=REPLACE_WITH_CERTIFICATE_THUMBPRINT
