SUNHAVEN_ENV=production
SUNHAVEN_AUTH_MODE=entra
SUNHAVEN_GRAPH_MODE=mock
SUNHAVEN_SEED_DEMO=0
SUNHAVEN_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SUNHAVEN_TENANT_ID=YOUR_TENANT_GUID
SUNHAVEN_CLIENT_ID=YOUR_APP_REGISTRATION_GUID
SUNHAVEN_CLIENT_SECRET=YOUR_SECRET_FROM_A_SECRET_MANAGER
SUNHAVEN_REDIRECT_URI=https://your-hostname.example/auth/callback
SUNHAVEN_SESSION_MINUTES=15

# Optional externally managed ledger signing key; minimum 32 characters.
# SUNHAVEN_LEDGER_KEY=replace-with-a-durable-random-key

# Optional AI provider. Leave unset for the fully local curated assistant.
# SUNHAVEN_AI_API_KEY=YOUR_SERVER_SIDE_OPENAI_API_KEY
# SUNHAVEN_AI_MODEL=gpt-4.1-mini
